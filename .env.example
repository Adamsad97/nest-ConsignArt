# Application
PORT=3000
NODE_ENV=development

# Database
DB_HOST=db
DB_PORT=5432
DB_USERNAME=consignart
DB_PASSWORD=change_me
DB_DATABASE=consignart_db

# JWT
JWT_SECRET=change-me-in-production
JWT_EXPIRATION=3600s
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_EXPIRATION=7d

# Admin bootstrap (used by `npm run seed:admin` only, never by the public API)
# Unrelated to the pgAdmin UI login below — this is the ConsignArt platform admin account.
ADMIN_EMAIL=platform-admin@consignart.com
ADMIN_PASSWORD=change_me_admin
ADMIN_FIRST_NAME=Platform
ADMIN_LAST_NAME=Admin
